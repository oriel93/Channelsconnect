# ============================================================
# Channels Connect — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# ============================================================

# --- Base44 / Backend ---
# Your Base44 app ID (used in base44Client.js — safe to expose in frontend)
VITE_BASE44_APP_ID=6862f92c2e623c50a6ce3dec

# --- Channex ---
# SECURITY NOTE: The Channex API key MUST NOT be stored in localStorage in production.
# Store it server-side in your Base44 backend environment and pass it via backend functions.
# This env var is for local development/testing only — never expose to the frontend bundle.
CHANNEX_API_KEY=your_channex_api_key_here

# --- Google Analytics ---
# Replace with your actual GA4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Cloudinary (if using direct upload) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# --- Production domain ---
VITE_APP_URL=https://channelsconnect.com

# --- AWS (server-side only, never prefix with VITE_) ---
# These are set in Lambda/ECS environment, NOT in this file
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
