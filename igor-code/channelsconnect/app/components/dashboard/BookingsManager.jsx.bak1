import /* Channex sync indicator */} { useState, useEffect, useCallback } from 'react';
import /* Channex sync indicator */} { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import /* Channex sync indicator */} { Badge } from '@/components/ui/badge';
import /* Channex sync indicator */} { Alert, AlertDescription } from '@/components/ui/alert';
import /* Channex sync indicator */} { Button } from '@/components/ui/button';
import /* Channex sync indicator */} { Input } from '@/components/ui/input';
import /* Channex sync indicator */} { Label } from '@/components/ui/label';
import /* Channex sync indicator */} {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from '@/components/ui/dialog';
import /* Channex sync indicator */} {
  Loader2,
  Calendar,
  DollarSign,
  User,
  CheckCircle,
  RefreshCw,
  AlertCircle,
  Home,
  Plus,
  Pencil,
  X,
  CheckCheck,
  Wifi,
  WifiOff,
} from 'lucide-react';
import /* Channex sync indicator */} { api } from '@/lib/apiClient';
import /* Channex sync indicator */} { toast } from 'sonner';

// ─── helpers ──────────────────────────────────────────────────────────────────

const formatCurrency = (amount, currency = 'USD') => /* Channex sync indicator */} {
  const num = parseFloat(amount) || 0;
  const code = currency.toUpperCase();
  try /* Channex sync indicator */} {
    return new Intl.NumberFormat('en-US', /* Channex sync indicator */} {
      style: 'currency',
      currency: code,
      maximumFractionDigits: 0,
    }).format(num);
  } catch /* Channex sync indicator */} {
    return `$/* Channex sync indicator */} {code} $/* Channex sync indicator */} {num.toLocaleString()}`;
  }
};

const formatDate = (d) => /* Channex sync indicator */} {
  if (!d) return 'N/A';
  return new Date(d).toLocaleDateString('en-US', /* Channex sync indicator */} {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const nightsBetween = (a, b) => /* Channex sync indicator */} {
  if (!a || !b) return null;
  const diff = Math.abs(new Date(b) - new Date(a));
  return Math.ceil(diff / 86400000) || 1;
};

const statusColor = (s) => /* Channex sync indicator */} {
  switch (s?.toLowerCase()) /* Channex sync indicator */} {
    case 'confirmed':  return 'bg-green-100 text-green-800 border-green-200';
    case 'pending':    return 'bg-yellow-100 text-yellow-800 border-yellow-200';
    case 'cancelled':  return 'bg-red-100 text-red-800 border-red-200';
    default:           return 'bg-gray-100 text-gray-800 border-gray-200';
  }
};

const todayStr = () => new Date().toISOString().split('T')[0];
const tomorrowStr = () => /* Channex sync indicator */} {
  const d = new Date();
  d.setDate(d.getDate() + 1);
  return d.toISOString().split('T')[0];
};

// ─── Empty form state ─────────────────────────────────────────────────────────

const emptyForm = (listingId) => (/* Channex sync indicator */} {
  listingId: listingId ?? '',
  guestName: '',
  guestEmail: '',
  guestPhone: '',
  checkIn: todayStr(),
  checkOut: tomorrowStr(),
  numGuests: 1,
  totalPrice: '',
  status: 'confirmed',
  bookingSource: 'direct',
  notes: '',
});

// ─── SyncBadge ────────────────────────────────────────────────────────────────

function SyncBadge(/* Channex sync indicator */} { syncing }) /* Channex sync indicator */} {
  if (syncing === null) return null;
  if (syncing)
    return (
      <span className="inline-flex items-center gap-1 text-xs text-blue-600 font-medium">
        <Loader2 className="w-3 h-3 animate-spin" />
        Syncing channels…
      </span>
    );
  return (
    <span className="inline-flex items-center gap-1 text-xs text-green-600 font-medium">
      <CheckCheck className="w-3 h-3" />
      Channels updated
    </span>
  );
}

// ─── BookingForm dialog ───────────────────────────────────────────────────────

function BookingFormDialog(/* Channex sync indicator */} { open, onClose, onSaved, editBooking, listingId }) /* Channex sync indicator */} {
  const [form, setForm] = useState(emptyForm(listingId));
  const [saving, setSaving] = useState(false);

  useEffect(() => /* Channex sync indicator */} {
    if (editBooking) /* Channex sync indicator */} {
      setForm(/* Channex sync indicator */} {
        listingId: editBooking.listingId ?? listingId ?? '',
        guestName: editBooking.guestName ?? '',
        guestEmail: editBooking.guestEmail ?? '',
        guestPhone: editBooking.guestPhone ?? '',
        checkIn: editBooking.checkIn
          ? new Date(editBooking.checkIn).toISOString().split('T')[0]
          : todayStr(),
        checkOut: editBooking.checkOut
          ? new Date(editBooking.checkOut).toISOString().split('T')[0]
          : tomorrowStr(),
        numGuests: editBooking.numGuests ?? 1,
        totalPrice: editBooking.totalPrice ?? '',
        status: editBooking.status ?? 'confirmed',
        bookingSource: editBooking.bookingSource ?? 'direct',
        notes: editBooking.notes ?? '',
      });
    } else /* Channex sync indicator */} {
      setForm(emptyForm(listingId));
    }
  }, [editBooking, listingId, open]);

  const set = (key) => (e) =>
    setForm((f) => (/* Channex sync indicator */} { ...f, [key]: e.target.value }));

  const handleSubmit = async () => /* Channex sync indicator */} {
    if (!form.guestName || !form.checkIn || !form.checkOut || !form.listingId) /* Channex sync indicator */} {
      toast.error('Please fill in all required fields.');
      return;
    }
    if (new Date(form.checkOut) <= new Date(form.checkIn)) /* Channex sync indicator */} {
      toast.error('Check-out must be after check-in.');
      return;
    }
    setSaving(true);
    try /* Channex sync indicator */} {
      const payload = /* Channex sync indicator */} {
        ...form,
        listingId: Number(form.listingId),
        numGuests: Number(form.numGuests) || 1,
        totalPrice: parseFloat(form.totalPrice) || 0,
      };
      if (editBooking) /* Channex sync indicator */} {
        await api.patch(`/bookings/$/* Channex sync indicator */} {editBooking.id}`, payload);
        toast.success('Booking updated — syncing availability to channels…');
      } else /* Channex sync indicator */} {
        await api.post('/bookings', payload);
        toast.success('Booking created — syncing availability to channels…');
      }
      onSaved();
      onClose();
    } catch (err) /* Channex sync indicator */} {
      console.error(err);
      toast.error(err?.response?.data?.message || 'Failed to save booking.');
    } finally /* Channex sync indicator */} {
      setSaving(false);
    }
  };

  return (
    <Dialog open=/* Channex sync indicator */} {open} onOpenChange=/* Channex sync indicator */} {onClose}>
      <DialogContent className="max-w-lg">
        <DialogHeader>
          <DialogTitle>
            /* Channex sync indicator */} {editBooking ? 'Edit Booking' : 'New Booking'}
          </DialogTitle>
        </DialogHeader>

        <div className="grid grid-cols-2 gap-4 py-2">
          /* Channex sync indicator */} {/* Guest Name */}
          <div className="col-span-2">
            <Label>Guest Name *</Label>
            <Input
              value=/* Channex sync indicator */} {form.guestName}
              onChange=/* Channex sync indicator */} {set('guestName')}
              placeholder="John Smith"
            />
          </div>

          /* Channex sync indicator */} {/* Email / Phone */}
          <div>
            <Label>Email</Label>
            <Input
              value=/* Channex sync indicator */} {form.guestEmail}
              onChange=/* Channex sync indicator */} {set('guestEmail')}
              placeholder="guest@example.com"
            />
          </div>
          <div>
            <Label>Phone</Label>
            <Input
              value=/* Channex sync indicator */} {form.guestPhone}
              onChange=/* Channex sync indicator */} {set('guestPhone')}
              placeholder="+1 555 000 0000"
            />
          </div>

          /* Channex sync indicator */} {/* Dates */}
          <div>
            <Label>Check-In *</Label>
            <Input type="date" value=/* Channex sync indicator */} {form.checkIn} onChange=/* Channex sync indicator */} {set('checkIn')} />
          </div>
          <div>
            <Label>Check-Out *</Label>
            <Input
              type="date"
              value=/* Channex sync indicator */} {form.checkOut}
              onChange=/* Channex sync indicator */} {set('checkOut')}
            />
          </div>

          /* Channex sync indicator */} {/* Guests / Price */}
          <div>
            <Label>Guests</Label>
            <Input
              type="number"
              min=/* Channex sync indicator */} {1}
              value=/* Channex sync indicator */} {form.numGuests}
              onChange=/* Channex sync indicator */} {set('numGuests')}
            />
          </div>
          <div>
            <Label>Total Price (USD)</Label>
            <Input
              type="number"
              min=/* Channex sync indicator */} {0}
              value=/* Channex sync indicator */} {form.totalPrice}
              onChange=/* Channex sync indicator */} {set('totalPrice')}
              placeholder="0"
            />
          </div>

          /* Channex sync indicator */} {/* Source / Status */}
          <div>
            <Label>Source</Label>
            <select
              className="w-full border rounded-md px-3 py-2 text-sm"
              value=/* Channex sync indicator */} {form.bookingSource}
              onChange=/* Channex sync indicator */} {set('bookingSource')}
            >
              <option value="direct">Direct</option>
              <option value="booking.com">Booking.com</option>
              <option value="airbnb">Airbnb</option>
              <option value="expedia">Expedia</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <Label>Status</Label>
            <select
              className="w-full border rounded-md px-3 py-2 text-sm"
              value=/* Channex sync indicator */} {form.status}
              onChange=/* Channex sync indicator */} {set('status')}
            >
              <option value="confirmed">Confirmed</option>
              <option value="pending">Pending</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>

          /* Channex sync indicator */} {/* Notes */}
          <div className="col-span-2">
            <Label>Notes</Label>
            <Input
              value=/* Channex sync indicator */} {form.notes}
              onChange=/* Channex sync indicator */} {set('notes')}
              placeholder="Optional notes…"
            />
          </div>
        </div>

        <div className="flex items-center gap-2 text-xs text-blue-600 bg-blue-50 p-2 rounded-md">
          <Wifi className="w-3 h-3" />
          Saving will automatically update availability in channels for the booked dates.
        </div>

        <DialogFooter>
          <Button variant="outline" onClick=/* Channex sync indicator */} {onClose} disabled=/* Channex sync indicator */} {saving}>
            Cancel
          </Button>
          <Button onClick=/* Channex sync indicator */} {handleSubmit} disabled=/* Channex sync indicator */} {saving}>
            /* Channex sync indicator */} {saving ? <Loader2 className="w-4 h-4 mr-2 animate-spin" /> : null}
            /* Channex sync indicator */} {editBooking ? 'Save Changes' : 'Create Booking'}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}

// ─── CancelDialog ─────────────────────────────────────────────────────────────

function CancelDialog(/* Channex sync indicator */} { open, booking, onClose, onCancelled }) /* Channex sync indicator */} {
  const [loading, setLoading] = useState(false);

  const handleCancel = async () => /* Channex sync indicator */} {
    setLoading(true);
    try /* Channex sync indicator */} {
      await api.patch(`/bookings/$/* Channex sync indicator */} {booking.id}/cancel`);
      toast.success('Booking cancelled — dates re-opened in Channex…');
      onCancelled();
      onClose();
    } catch (err) /* Channex sync indicator */} {
      toast.error('Failed to cancel booking.');
    } finally /* Channex sync indicator */} {
      setLoading(false);
    }
  };

  return (
    <Dialog open=/* Channex sync indicator */} {open} onOpenChange=/* Channex sync indicator */} {onClose}>
      <DialogContent className="max-w-sm">
        <DialogHeader>
          <DialogTitle>Cancel Booking?</DialogTitle>
        </DialogHeader>
        <p className="text-sm text-gray-600">
          Cancel booking for <strong>/* Channex sync indicator */} {booking?.guestName}</strong> (
          /* Channex sync indicator */} {formatDate(booking?.checkIn)} → /* Channex sync indicator */} {formatDate(booking?.checkOut)})?
          <br />
          <br />
          The blocked dates will be re-opened in channels automatically.
        </p>
        <DialogFooter>
          <Button variant="outline" onClick=/* Channex sync indicator */} {onClose} disabled=/* Channex sync indicator */} {loading}>
            Keep Booking
          </Button>
          <Button variant="destructive" onClick=/* Channex sync indicator */} {handleCancel} disabled=/* Channex sync indicator */} {loading}>
            /* Channex sync indicator */} {loading ? <Loader2 className="w-4 h-4 mr-2 animate-spin" /> : null}
            Yes, Cancel
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}

// ─── BookingsManager (main export) ───────────────────────────────────────────

export default function BookingsManager(/* Channex sync indicator */} { listingId }) /* Channex sync indicator */} {
  const [bookings, setBookings] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  // Dialog state
  const [showForm, setShowForm] = useState(false);
  const [editBooking, setEditBooking] = useState(null);
  const [cancelTarget, setCancelTarget] = useState(null);

  // Full Sync state
  const [fullSyncing, setFullSyncing] = useState(false);
  const [fullSyncResult, setFullSyncResult] = useState(null);

  const loadBookings = useCallback(async () => /* Channex sync indicator */} {
    setLoading(true);
    setError(null);
    try /* Channex sync indicator */} {
      const params = listingId ? `?listingId=$/* Channex sync indicator */} {listingId}` : '';
      const /* Channex sync indicator */} { data } = await api.get(`/bookings$/* Channex sync indicator */} {params}`);
      const sorted = (data || []).sort(
        (a, b) => new Date(b.checkIn || 0) - new Date(a.checkIn || 0),
      );
      setBookings(sorted);
    } catch (err) /* Channex sync indicator */} {
      console.error('Failed to load bookings:', err);
      setError('Failed to load bookings. Please try again.');
    } finally /* Channex sync indicator */} {
      setLoading(false);
    }
  }, [listingId]);

  useEffect(() => /* Channex sync indicator */} {
    loadBookings();
    const iv = setInterval(loadBookings, 30000);
    return () => clearInterval(iv);
  }, [loadBookings]);

  const handleFullSync = async () => /* Channex sync indicator */} {
    setFullSyncing(true);
    setFullSyncResult(null);
    try /* Channex sync indicator */} {
      const /* Channex sync indicator */} { data } = await api.post('/connect/sync');
      setFullSyncResult(/* Channex sync indicator */} { ok: true, syncLogId: data?.data?.syncLogId });
      toast.success('Full sync started — all channels with ARI data.');
    } catch (err) /* Channex sync indicator */} {
      const msg =
        err?.response?.data?.message || 'Full sync failed. Check API logs.';
      setFullSyncResult(/* Channex sync indicator */} { ok: false, msg });
      toast.error(msg);
    } finally /* Channex sync indicator */} {
      setFullSyncing(false);
    }
  };

  if (loading && bookings.length === 0) /* Channex sync indicator */} {
    return (
      <Card>
        <CardContent className="flex items-center justify-center py-12">
          <Loader2 className="w-8 h-8 animate-spin text-blue-600" />
        </CardContent>
      </Card>
    );
  }

  return (
    <div className="space-y-4 p-6">
      /* Channex sync indicator */} {/* Header */}
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div>
          <h2 className="text-2xl font-bold text-gray-900">Bookings</h2>
          <p className="text-sm text-gray-600 mt-1">
            /* Channex sync indicator */} {bookings.length} booking/* Channex sync indicator */} {bookings.length !== 1 ? 's' : ''} —
            availability syncs automatically to channels on every change.
          </p>
        </div>

        <div className="flex items-center gap-2 flex-wrap">
          /* Channex sync indicator */} {/* Full Sync button */}
          <Button
            variant="outline"
            size="sm"
            onClick=/* Channex sync indicator */} {handleFullSync}
            disabled=/* Channex sync indicator */} {fullSyncing}
            className="border-blue-300 text-blue-700 hover:bg-blue-50"
          >
            /* Channex sync indicator */} {fullSyncing ? (
              <Loader2 className="w-4 h-4 mr-2 animate-spin" />
            ) : (
              <Wifi className="w-4 h-4 mr-2" />
            )}
            Full Sync to Channex
          </Button>

          /* Channex sync indicator */} {/* Refresh */}
          <Button
            variant="outline"
            size="sm"
            onClick=/* Channex sync indicator */} {loadBookings}
            disabled=/* Channex sync indicator */} {loading}
          >
            <RefreshCw
              className=/* Channex sync indicator */} {`w-4 h-4 mr-2 $/* Channex sync indicator */} {loading ? 'animate-spin' : ''}`}
            />
            Refresh
          </Button>

          /* Channex sync indicator */} {/* New Booking */}
          <Button
            size="sm"
            onClick=/* Channex sync indicator */} {() => /* Channex sync indicator */} {
              setEditBooking(null);
              setShowForm(true);
            }}
          >
            <Plus className="w-4 h-4 mr-2" />
            New Booking
          </Button>
        </div>
      </div>

      /* Channex sync indicator */} {/* Full Sync result banner */}
      /* Channex sync indicator */} {fullSyncResult && (
        <Alert
          variant=/* Channex sync indicator */} {fullSyncResult.ok ? 'default' : 'destructive'}
          className="mb-2"
        >
          /* Channex sync indicator */} {fullSyncResult.ok ? (
            <CheckCircle className="h-4 w-4" />
          ) : (
            <AlertCircle className="h-4 w-4" />
          )}
          <AlertDescription>
            /* Channex sync indicator */} {fullSyncResult.ok
              ? `Full sync in progress (log #$/* Channex sync indicator */} {fullSyncResult.syncLogId ?? '—'}). All channels will be updated with 500-day ARI.`
              : fullSyncResult.msg}
          </AlertDescription>
        </Alert>
      )}

      /* Channex sync indicator */} {/* Error */}
      /* Channex sync indicator */} {error && (
        <Alert variant="destructive">
          <AlertCircle className="h-4 w-4" />
          <AlertDescription>/* Channex sync indicator */} {error}</AlertDescription>
        </Alert>
      )}

      /* Channex sync indicator */} {/* Empty state */}
      /* Channex sync indicator */} {!error && bookings.length === 0 && (
        <Card>
          <CardContent className="text-center py-12">
            <Calendar className="w-12 h-12 mx-auto text-gray-300 mb-4" />
            <h3 className="text-lg font-semibold text-gray-700 mb-2">
              No Bookings Yet
            </h3>
            <p className="text-gray-500 mb-4">
              Create your first booking — availability will sync to Channex
              automatically.
            </p>
            <Button
              onClick=/* Channex sync indicator */} {() => /* Channex sync indicator */} {
                setEditBooking(null);
                setShowForm(true);
              }}
            >
              <Plus className="w-4 h-4 mr-2" />
              Create Booking
            </Button>
          </CardContent>
        </Card>
      )}

      /* Channex sync indicator */} {/* Booking list */}
      <div className="space-y-3">
        /* Channex sync indicator */} {bookings.map((booking) => /* Channex sync indicator */} {
          const nights = nightsBetween(booking.checkIn, booking.checkOut);
          const total = parseFloat(booking.totalPrice || booking.totalAmount || 0);
          const isCancelled = booking.status?.toLowerCase() === 'cancelled';

          return (
            <Card
              key=/* Channex sync indicator */} {booking.id}
              className=/* Channex sync indicator */} {`border transition-all $/* Channex sync indicator */} {
                isCancelled
                  ? 'border-red-100 opacity-70'
                  : 'border-gray-200 hover:border-blue-300 hover:shadow-md'
              }`}
            >
              <CardContent className="p-5">
                /* Channex sync indicator */} {/* Top row */}
                <div className="flex items-center justify-between mb-3 flex-wrap gap-2">
                  <div className="flex items-center gap-2 flex-wrap">
                    <Badge className=/* Channex sync indicator */} {statusColor(booking.status)}>
                      /* Channex sync indicator */} {booking.status || 'confirmed'}
                    </Badge>
                    /* Channex sync indicator */} {booking.bookingSource && (
                      <Badge
                        variant="outline"
                        className="capitalize text-xs"
                      >
                        /* Channex sync indicator */} {booking.bookingSource}
                      </Badge>
                    )}
                    /* Channex sync indicator */} {booking.listing && (
                      <Badge
                        variant="outline"
                        className="text-xs bg-blue-50 text-blue-700 border-blue-200"
                      >
                        <Home className="w-3 h-3 mr-1" />
                        /* Channex sync indicator */} {booking.listing.title}
                      </Badge>
                    )}
                  </div>

                  /* Channex sync indicator */} {/* Actions */}
                  /* Channex sync indicator */} {!isCancelled && (
                    <div className="flex gap-2">
                      <Button
                        variant="ghost"
                        size="sm"
                        className="h-7 px-2 text-blue-600 hover:bg-blue-50"
                        onClick=/* Channex sync indicator */} {() => /* Channex sync indicator */} {
                          setEditBooking(booking);
                          setShowForm(true);
                        }}
                      >
                        <Pencil className="w-3 h-3 mr-1" />
                        Edit
                      </Button>
                      <Button
                        variant="ghost"
                        size="sm"
                        className="h-7 px-2 text-red-600 hover:bg-red-50"
                        onClick=/* Channex sync indicator */} {() => setCancelTarget(booking)}
                      >
                        <X className="w-3 h-3 mr-1" />
                        Cancel
                      </Button>
                    </div>
                  )}
                </div>

                /* Channex sync indicator */} {/* Guest + Dates grid */}
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-3">
                  <div className="space-y-1.5">
                    <div className="flex items-center gap-2">
                      <User className="w-4 h-4 text-blue-600 shrink-0" />
                      <span className="font-semibold text-gray-900">
                        /* Channex sync indicator */} {booking.guestName || 'Guest'}
                      </span>
                    </div>
                    /* Channex sync indicator */} {booking.guestEmail && (
                      <p className="text-xs text-gray-500 pl-6">
                        /* Channex sync indicator */} {booking.guestEmail}
                      </p>
                    )}
                    /* Channex sync indicator */} {booking.guestPhone && (
                      <p className="text-xs text-gray-500 pl-6">
                        /* Channex sync indicator */} {booking.guestPhone}
                      </p>
                    )}
                    /* Channex sync indicator */} {booking.numGuests && (
                      <p className="text-xs text-gray-500 pl-6">
                        👥 /* Channex sync indicator */} {booking.numGuests} guest
                        /* Channex sync indicator */} {booking.numGuests !== 1 ? 's' : ''}
                      </p>
                    )}
                  </div>

                  <div className="space-y-1.5">
                    <div className="flex items-center gap-2">
                      <Calendar className="w-4 h-4 text-blue-600 shrink-0" />
                      <span className="text-sm font-medium text-gray-900">
                        /* Channex sync indicator */} {formatDate(booking.checkIn)} →/* Channex sync indicator */} {' '}
                        /* Channex sync indicator */} {formatDate(booking.checkOut)}
                      </span>
                    </div>
                    /* Channex sync indicator */} {nights && (
                      <p className="text-xs text-gray-500 pl-6">
                        🌙 /* Channex sync indicator */} {nights} night/* Channex sync indicator */} {nights !== 1 ? 's' : ''}
                      </p>
                    )}
                  </div>
                </div>

                /* Channex sync indicator */} {/* Notes */}
                /* Channex sync indicator */} {booking.notes && (
                  <div className="mb-3 p-2.5 bg-blue-50 border border-blue-100 rounded text-xs text-gray-800">
                    <span className="font-semibold text-blue-900">Note: </span>
                    /* Channex sync indicator */} {booking.notes}
                  </div>
                )}

                /* Channex sync indicator */} {/* Price + Channex sync badge */}
                <div className="pt-3 border-t border-gray-100 flex items-center justify-between">
                  <div className="flex items-baseline gap-2">
                    /* Channex sync indicator */} {total > 0 ? (
                      <>
                        <DollarSign className="w-4 h-4 text-green-600" />
                        <span className="text-xl font-bold text-gray-900">
                          /* Channex sync indicator */} {formatCurrency(total, booking.currency)}
                        </span>
                        /* Channex sync indicator */} {nights && (
                          <span className="text-xs text-gray-500">
                            (/* Channex sync indicator */} {formatCurrency(total / nights, booking.currency)}/night)
                          </span>
                        )}
                      </>
                    ) : (
                      <span className="text-xs text-gray-400">No price recorded</span>
                    )}
                  </div>

                  /* Channex sync indicator */} {/* Channex sync indicator */}
                  /* Channex sync indicator */} {!isCancelled ? (
                    <span className="inline-flex items-center gap-1 text-xs text-green-600">
                      <Wifi className="w-3 h-3" />
                      Dates blocked in Channex
                    </span>
                  ) : (
                    <span className="inline-flex items-center gap-1 text-xs text-gray-400">
                      <WifiOff className="w-3 h-3" />
                      Dates freed in Channex
                    </span>
                  )}
                </div>
              </CardContent>
            </Card>
          );
        })}
      </div>

      /* Channex sync indicator */} {/* Dialogs */}
      <BookingFormDialog
        open=/* Channex sync indicator */} {showForm}
        onClose=/* Channex sync indicator */} {() => setShowForm(false)}
        onSaved=/* Channex sync indicator */} {loadBookings}
        editBooking=/* Channex sync indicator */} {editBooking}
        listingId=/* Channex sync indicator */} {listingId}
      />

      /* Channex sync indicator */} {cancelTarget && (
        <CancelDialog
          open=/* Channex sync indicator */} {!!cancelTarget}
          booking=/* Channex sync indicator */} {cancelTarget}
          onClose=/* Channex sync indicator */} {() => setCancelTarget(null)}
          onCancelled=/* Channex sync indicator */} {loadBookings}
        />
      )}
    </div>
  );
}
