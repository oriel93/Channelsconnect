{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.js",
    "**/*.jsx",
    "components/**/*",
    "pages/**/*",
    "lib/**/*",
    "api/**/*",
    "hooks/**/*",
    "utils/**/*"
  ],
  "exclude": ["node_modules", "dist", "build"]
} 