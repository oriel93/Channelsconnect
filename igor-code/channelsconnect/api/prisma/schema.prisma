generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  name                    String?
  avatarUrl               String?
  role                    String                @default("user")
  airbnbHostId            String?
  syncStatus              SyncStatus            @default(idle)
  syncStartedAt           DateTime?
  syncCompletedAt         DateTime?
  syncError               String?
  payoutAccountHolderName String?
  payoutRoutingNumber     String?
  payoutAccountNumber     String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  signupIp                String?
  tosAcceptedAt           DateTime?
  tos_accepted_at         DateTime?             @db.Timestamptz(6)
  signup_ip               String?
  phone                   String?
  adminMarkup             Decimal?             @default(0) @db.Decimal(5, 2)  // % markup applied to all rates before Channex push (admin-only)
  airbnbConnections       AirbnbConnection?
  bookings                Booking[]
  calendarAuditLogs       CalendarAuditLog[]
  channelConnections      ChannelConnection[]
  channexMappings         ChannexMapping[]
  icalConnections         IcalConnection[]
  leads                   Lead[]
  listings                Listing[]
  priceLabsIntegrations   PriceLabsIntegration?
  propertyConnections     PropertyConnection[]
  propertyImages          PropertyImage[]
  syncLogs                SyncLog[]

  @@map("users")
}

model Channel {
  id                 Int                 @id @default(autoincrement())
  name               String
  slug               String              @unique
  description        String?
  logoUrl            String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  channelConnections ChannelConnection[]

  @@map("channels")
}

model RoomType {
  id                   Int         @id @default(autoincrement())
  listingId            Int
  name                 String
  description          String?
  maxGuests            Int
  bedType              String?
  quantity             Int         @default(1)
  channexRoomTypeId    String?     @map("channexRoomTypeId")   // populated after Step B
  channexRatePlanId    String?     @map("channexRatePlanId")   // populated after Step C
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  blockedDates         BlockedDate[]
  bookings             Booking[]
  inventory            Inventory[]
  listing              Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rates                Rate[]

  @@map("room_types")
}

model Inventory {
  id         Int      @id @default(autoincrement())
  roomTypeId Int
  date       DateTime @db.Date
  available  Int
  booked     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@map("inventory")
}

model Booking {
  id            Int      @id @default(autoincrement())
  userId        String
  listingId     Int
  roomTypeId    Int?     @map("roomTypeId")     // nullable for legacy bookings + single-room listings
  guestName     String
  guestEmail    String?
  guestPhone    String?
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  numGuests     Int
  totalPrice    Decimal  @db.Decimal(10, 2)
  status        String   @default("confirmed")
  bookingSource String?
  externalId    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType      RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([roomTypeId])
  @@index([userId])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

model Lead {
  id        Int      @id @default(autoincrement())
  userId    String?
  email     String
  name      String?
  phone     String?
  message   String?
  source    String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@map("leads")
}

model PropertyConnection {
  id               Int       @id @default(autoincrement())
  userId           String
  listingId        Int
  externalPlatform String
  externalId       String
  credentials      Json?
  syncEnabled      Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, externalPlatform])
  @@map("property_connections")
}

model Listing {
  id                  Int                  @id @default(autoincrement())
  userId              String
  title               String
  description         String?
  address             String?
  city                String?
  state               String?
  country             String?
  postalCode          String?
  latitude            Decimal?             @db.Decimal(10, 8)
  longitude           Decimal?             @db.Decimal(11, 8)
  propertyType        String?
  bedrooms            Int?
  bathrooms           Decimal?             @db.Decimal(3, 1)
  maxGuests           Int?
  basePrice           Decimal?             @db.Decimal(10, 2)
  currency            String               @default("USD")
  amenities           Json?
  houseRules          String?
  cancellationPolicy  String?
  checkInTime         String?
  checkOutTime        String?
  minNights           Int                  @default(1)
  maxNights           Int?
  isActive            Boolean              @default(true)
  beds                Int?
  channexPropertyId   String?   @unique @map("channexPropertyId")
  channexRoomId       String?   @map("channexRoomId")
  isArchived          Boolean   @default(false) @map("isArchived")
  archivedAt          DateTime? @map("archivedAt")
  airbnbListingId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  captureUrl          String?
  source              String               @default("channex")
  reviewStatus        String               @default("approved")
  blockedDates        BlockedDate[]
  bookings            Booking[]
  calendar            Calendar[]
  calendarEvents      CalendarEvent[]
  channexMappings     ChannexMapping[]
  icalConnections     IcalConnection[]
  importedListings    ImportedListing[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricingRules        PricingRule[]
  propertyConnections PropertyConnection[]
  propertyImages      PropertyImage[]
  propertyPricing     PropertyPricing?
  rates               Rate[]
  roomTypes           RoomType[]

  @@index([userId])
  @@index([city, country])
  @@index([channexPropertyId, channexRoomId])
  @@index([airbnbListingId])
  @@map("listings")
}

model Rate {
  id         Int       @id @default(autoincrement())
  listingId  Int
  roomTypeId Int?      @map("roomTypeId")   // per-room rate; null = legacy listing-level row
  date       DateTime  @db.Date
  price      Decimal   @db.Decimal(10, 2)
  minStay    Int?
  available  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  // Allow one rate row per (listing, room_type, date). Legacy rows with NULL
  // roomTypeId are still constrained to one per (listing, date) by the old key.
  @@unique([listingId, date], name: "listingId_date")
  @@index([date])
  @@index([roomTypeId])
  @@map("rates")
}

model ChannelsConnectBooking {
  id         Int      @id @default(autoincrement())
  bookingRef String   @unique
  listingId  Int
  guestName  String
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  totalPrice Decimal  @db.Decimal(10, 2)
  status     String
  syncStatus String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([listingId])
  @@map("channels_connect_bookings")
}

model BlockedDate {
  id         Int       @id @default(autoincrement())
  listingId  Int
  roomTypeId Int?      @map("roomTypeId")
  date       DateTime  @db.Date
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([roomTypeId])
  @@index([listingId])
  @@index([date])
  @@index([listingId, date])
  @@map("blocked_dates")
}

model PricingRule {
  id         Int       @id @default(autoincrement())
  listingId  Int
  name       String
  ruleType   String
  conditions Json
  adjustment Decimal   @db.Decimal(5, 2)
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("pricing_rules")
}

model PropertyImage {
  id                    Int       @id @default(autoincrement())
  userId                String
  listingId             Int
  url                   String
  thumbnailUrl          String?
  caption               String?
  displayOrder          Int       @default(0)
  isPrimary             Boolean   @default(false)
  cloudinaryId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  filename              String?
  highResConvertedAt    DateTime?
  highResStoragePath    String?
  highResUrl            String?
  isCover               Boolean   @default(false)
  sortOrder             Int       @default(0)
  storagePath           String?
  is_cover              Boolean?  @default(false)
  listing_id            String?   @db.Uuid
  sort_order            Int?      @default(0)
  storage_path          String?
  high_res_url          String?
  high_res_storage_path String?
  high_res_converted_at DateTime? @db.Timestamptz(6)
  listing               Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("property_images")
}

model IcalConnection {
  id             Int       @id @default(autoincrement())
  userId         String
  listingId      Int
  name           String
  icalUrl        String
  syncDirection  String    @default("import")
  lastSyncAt     DateTime?
  lastSyncStatus String?
  syncEnabled    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("ical_connections")
}

model PriceLabsIntegration {
  id         Int       @id @default(autoincrement())
  userId     String    @unique
  apiKey     String
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pricelabs_integrations")
}

model PropertyPricing {
  id                Int       @id @default(autoincrement())
  listingId         Int       @unique
  strategy          String    @default("fixed")
  basePrice         Decimal   @db.Decimal(10, 2)
  weekendMultiplier Decimal?  @db.Decimal(3, 2)
  monthlyDiscount   Decimal?  @db.Decimal(5, 2)
  lastUpdateAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  listing           Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("property_pricing")
}

model ChannelConnection {
  id          Int       @id @default(autoincrement())
  userId      String
  channelId   Int
  listingId   Int
  externalId  String?
  credentials Json?
  isActive    Boolean   @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId, listingId])
  @@map("channel_connections")
}

model CalendarAuditLog {
  id         Int      @id @default(autoincrement())
  userId     String
  action     String
  entityType String
  entityId   Int
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("calendar_audit_logs")
}

model AirbnbConnection {
  id           Int       @id @default(autoincrement())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("airbnb_connections")
}

model ImportedListing {
  id              Int      @id @default(autoincrement())
  listingId       Int?
  source          String
  externalId      String
  rawData         Json
  importStatus    String   @default("pending")
  matchConfidence Decimal? @db.Decimal(3, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  listing         Listing? @relation(fields: [listingId], references: [id])

  @@unique([source, externalId])
  @@map("imported_listings")
}

model SyncLog {
  id         Int      @id @default(autoincrement())
  userId     String
  syncType   String
  entityType String
  entityId   Int?
  status     String
  message    String?
  details    Json?
  duration   Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([syncType, status])
  @@map("sync_logs")
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  listingId   Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  eventType   String
  source      String?
  externalId  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([startDate, endDate])
  @@map("calendar_events")
}

model ChannexMapping {
  id                String    @id @default(uuid())
  userId            String
  listingId         Int?
  channexPropertyId String
  channexRoomTypeId String?
  channexRatePlanId String?
  channelType       String    @default("airbnb")
  oauthState        String?
  accessToken       String?
  tokenExpiresAt    DateTime?
  syncStatus        String    @default("pending")
  lastSyncAt        DateTime?
  lastSyncTaskId    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  listing           Listing?  @relation(fields: [listingId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channexPropertyId])
  @@unique([userId, listingId])
  @@map("channex_mappings")
}

model Calendar {
  id        Int      @id @default(autoincrement())
  listingId Int
  roomId    Int
  date      DateTime @db.Date
  price     Decimal? @db.Decimal(10, 2)
  numAvail  Int?
  minStay   Int?
  maxStay   Int?
  override  String?
  rawData   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
  @@index([date])
  @@index([listingId, date])
  @@map("calendar")
}

enum SyncStatus {
  idle
  syncing
  completed
  failed
}
